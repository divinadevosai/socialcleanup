{
  "manifest_version": 3,
  "name": "Social Cleanup",
  "version": "0.4.1",
  "description": "Bulk-delete your old social media posts by date range. Everything runs locally in your browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "*://*.reddit.com/*",
    "*://x.com/*",
    "*://twitter.com/*",
    "*://abs.twimg.com/*",
    "*://*.facebook.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "background": {
    "service_worker": "src/background/worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Social Cleanup",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.reddit.com/*"
      ],
      "js": [
        "src/adapters/reddit.js",
        "src/content/index.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*"
      ],
      "js": [
        "src/adapters/x.js",
        "src/content/index.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "src/content/dom-utils.js",
        "src/adapters/facebook.js",
        "src/content/index.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
